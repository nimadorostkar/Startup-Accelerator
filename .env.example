# Fundup Club — environment for docker compose (and the API when run by hand).
# Copy to `.env` and fill in. Never commit `.env`.
#
# Generate secrets with:  openssl rand -hex 32

# ---------------------------------------------------------------- site

# Public address of the website. Links in emails, Google sign-in and the
# trusted-origin check all use it. No trailing slash.
SITE_URL=http://localhost
# What Caddy serves and gets a TLS certificate for: your domain (e.g. fundup.club),
# or http://localhost to run the whole stack on your machine without TLS.
SITE_ADDRESS=http://localhost
# Send the sign-in cookies over HTTPS only. Set to false only to run the whole stack on
# plain http://localhost (the dev stack already does that for the API).
COOKIE_SECURE=true

# ---------------------------------------------------------------- API (Django)

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
# Extra host names the API answers to (comma-separated). The site's own domain (from
# SITE_URL) and the internal names (backend, localhost) are always allowed.
DJANGO_ALLOWED_HOSTS=
# Extra origins allowed to send cookie-authenticated requests (SITE_URL is always allowed).
CSRF_TRUSTED_ORIGINS=
# Load the launch events and newsletter issues on a brand-new database.
SEED_CONTENT=1
# Show the interactive API docs at /api/v1/docs/. Empty: only when DJANGO_DEBUG=true.
API_DOCS_PUBLIC=
# Gunicorn processes and threads per process; Celery worker processes.
WEB_CONCURRENCY=3
WEB_THREADS=4
CELERY_CONCURRENCY=2
LOG_LEVEL=INFO

# ---------------------------------------------------------------- database

POSTGRES_DB=fundup
POSTGRES_USER=fundup
# Letters and digits only (it's placed in a URL).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# ---------------------------------------------------------------- email

# SMTP server for verification, password reset and notification emails
# (e.g. smtp.resend.com, smtp.postmarkapp.com, email-smtp.<region>.amazonaws.com).
# Leave EMAIL_HOST empty to print emails to the worker's log instead (docker compose logs worker):
# the background worker is what sends them.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Fundup Club <hello@example.com>
# Contact-form messages go to these addresses (comma-separated). Empty: every reviewer.
SUPPORT_EMAILS=

# ---------------------------------------------------------------- Google sign-in (optional)

# OAuth client from Google Cloud Console. Authorised redirect URI:
#   <SITE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- cache refresh

# Shared by the API and the website: lets the API tell the website to refresh
# its cached events, articles and startup pages the moment they change.
REVALIDATE_SECRET=change-me-to-another-long-random-string

# ---------------------------------------------------------------- error tracking (optional)

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
