# Fundup Club — reverse proxy with automatic HTTPS.
#
# SITE_ADDRESS is your domain (e.g. fundup.club): Caddy fetches and renews the
# certificate itself. Use "http://localhost" to run the stack locally without TLS.
#
# Caddy replaces any X-Forwarded-For a visitor sends with the address it sees,
# which is what the API's rate limits count. If you put a load balancer in
# front of Caddy, trust only its addresses, e.g.:
#
#   {
#   	servers {
#   		trusted_proxies static 10.0.0.0/8
#   	}
#   }

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Room for an image upload (5 MB at most, checked by the API) and its form.
	request_body {
		max_size 6MB
	}

	# The back office's address as people type it
	redir /backoffice /backoffice/ 308

	# `keepalive 30s`, twice below: idle connections to the website and the API are
	# dropped here after 30 s, well before either of them closes one (75 s:
	# KEEP_ALIVE_TIMEOUT in the Dockerfile, `keepalive` in backend/gunicorn.conf.py).
	# The other way round, a request sent as the connection closes is lost, and a
	# form post can't be retried: the visitor gets an error page.

	# Startup logos and founder photos, straight from the `media` volume the API
	# writes them to. A file never changes once written (a new upload gets a new
	# name), so browsers may keep them for good.
	@media path_regexp ^/api/v1/media/(startups|founders)/[0-9a-f]{32}\.webp$
	handle @media {
		root * /srv
		uri strip_prefix /api/v1
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The API and the back office (Django)
	@django path /api/v1/* /backoffice/*
	handle @django {
		reverse_proxy backend:8000 {
			header_up X-Request-ID {http.request.uuid}
			transport http {
				keepalive 30s
			}
		}
	}

	# Everything else is the website (Next.js), streamed without buffering
	handle {
		reverse_proxy frontend:3000 {
			flush_interval -1
			header_up X-Request-ID {http.request.uuid}
			transport http {
				keepalive 30s
			}
		}
	}

	log {
		output stdout
		format json
	}
}
